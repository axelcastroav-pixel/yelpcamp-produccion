<% layout('layouts/boilerplate') %>

<!-- 1. Cargamos el CSS y JS del SDK de MapTiler para el navegador -->
<script src="https://cdn.maptiler.com/maptiler-sdk-js/v2.3.0/maptiler-sdk.umd.js"></script>
<link href="https://cdn.maptiler.com/maptiler-sdk-js/v2.3.0/maptiler-sdk.css" rel="stylesheet" />

<div class="row">
    <!-- PRIMERA COLUMNA: Cambiamos col-6 a col-md-6 -->
    <div class="col-md-6">

        <!-- 2. Este es el "lienzo" en blanco donde MapTiler dibujará el mapa -->
        <!-- Le agregamos mb-3 para separarlo de la tarjeta de abajo -->
        <div id="map" class="mb-3"></div>

        <div class="card mb-3">
            <!--INICIA CARROUSEL DE BOOSTRAP-->
            <div id="carouselStackedBottom" class="carousel slide">
                <div class="carousel-inner rounded-5">
                    <% for (let i=0; i< campground.images.length; i++) { %>
                        <div class="carousel-item <%= i===0 ? 'active' : ''  %>">
                            <img src="<%= campground.images[i].url  %>" class="d-block w-100" alt="...">
                        </div>
                    <% } %>
                </div>

                <% if (campground.images.length > 1) { %>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselStackedBottom" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselStackedBottom" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                <% } %>
            </div>
            <!--ACABA CARROUSEL-->

            <div class="card-body">
                <h5 class="card-title">
                    <%= campground.title %>
                </h5>
                <p class="card-text">
                    <%= campground.description %>
                </p>
            </div>

            <ul class="list-group list-group-flush">
                <li class="list-group-item text-muted">
                    <%= campground.location %>
                </li>
                <li class="list-group-item">
                    Subido por: <%= campground.author.username %>
                </li>
                <li class="list-group-item">
                    $<%= campground.price %>/noche
                </li>
            </ul>

            <% if (currentUser && campground.author.equals(currentUser._id)) { %>
                <div class="card-body">
                    <a href="/campgrounds/<%= campground._id %>/edit" class="card-link btn btn-info">Editar</a>
                    <form class="d-inline" action="/campgrounds/<%= campground._id %>?_method=DELETE" method="POST">
                        <button class="btn btn-danger">Eliminar</button>
                    </form>
                </div>
            <% } %>

            <div class="card-footer text-muted">
                <a href="/campgrounds" class="text-decoration-none">Volver a todos los campamentos</a>
            </div>
        </div>
    </div>

    <!-- SEGUNDA COLUMNA: Cambiamos col-6 a col-md-6 -->
    <div class="col-md-6">
        <% if (currentUser) { %>
            <h2>Leave a Review</h2>
            <!-- 1. Formulario de creación de reseñas -->
            <form action="/campgrounds/<%= campground._id %>/reviews" class="mb-3 validated-form" novalidate method="POST">
                
                <div class="mb-3">
                    <fieldset class="starability-basic">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="body">Review</label>
                    <textarea class="form-control" name="review[body]" id="body" cols="30" rows="3" required></textarea>
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                </div>
                <button class="btn btn-success">Submit</button>
            </form>
        <% } %>

        <!-- 2. Bucle independiente de reseñas -->
        <% for (let review of campground.reviews) { %>
            <div class="card mb-3">
                <div class="card-body">
                    <p class="starability-result" data-rating="<%= review.rating %>">
                        Rated: <%= review.rating %> stars
                    </p>
                    <h6 class="card-subtitle mb-2 text-muted">Por: <%= review.author.username %></h6>
                    <p class="card-text">Review: <%= review.body %></p>

                    <!-- 3. Formulario exclusivo para eliminar esta reseña -->
                    <% if (currentUser && review.author.equals(currentUser._id)) { %>
                        <form action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                            <button class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    <% } %>
                </div>
            </div>
        <% } %>
    </div>
</div>

<!-- Scripts de datos y ejecución del mapa -->
<script>
    const maptilerApiKey = '<%- process.env.MAPTILER_API_KEY %>';
    const campground = <%- JSON.stringify(campground) %>;
</script>
<script src="/javascripts/showPageMap.js"></script>
<% layout('layouts/boilerplate') %>

<div class="row">
    <!-- Tu centrado original, más un ajuste para pantallas extra grandes (xl) -->
    <div class="col-md-6 offset-md-3 col-xl-4 offset-xl-4">
        
        <!-- Aquí empieza el div central con sombra -->
        <div class="card shadow">
            
            <img src="https://images.unsplash.com/photo-1571863533956-01c88e79957e?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=1267&q=80"
                alt="Camping login" class="card-img-top" />
            
            <div class="card-body">
                <h5 class="card-title">Login</h5>
                
                <form action="/login" method="POST" class="validated-form" novalidate>
                    <div class="mb-3">
                        <label class="form-label" for="username">Username</label>
                        <input class="form-control" type="text" id="username" name="username" required autofocus>
                        <div class="valid-feedback">¡Se ve bien!</div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label" for="password">Password</label>
                        <input class="form-control" type="password" id="password" name="password" required>
                        <div class="valid-feedback">¡Se ve bien!</div>
                    </div>
                    
                    <button class="btn btn-success w-100">Login</button>
                </form>
                
            </div>
        </div>
        
    </div>
</div>
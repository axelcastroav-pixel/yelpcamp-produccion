<% layout('layouts/boilerplate') %>

<div class="row">
    <!-- Centramos el contenido en la pantalla -->
    <div class="col-md-6 offset-md-3 col-xl-4 offset-xl-4">
        
        <div class="card shadow">
            
            <!-- Imagen de adorno en la parte superior -->
            <img src="https://images.unsplash.com/photo-1533873984035-25970ab07461?ixlib=rb-1.2.1&auto=format&fit=crop&w=1267&q=80"
                alt="Camping register" class="card-img-top" />
            
            <div class="card-body">
                <h5 class="card-title">Register</h5>
                
                <!-- Tu formulario original empieza aquí -->
                <form action="/register" method="POST" class="validated-form" novalidate>

                    <div class="mb-3">
                        <label class="form-label" for="username">Username</label>
                        <input class="form-control" type="text" id="username" name="username" required autofocus>
                        <div class="valid-feedback">Looks good!</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="email">Email</label>
                        <input class="form-control" type="email" id="email" name="email" required>
                        <div class="valid-feedback">Looks good!</div>
                    </div>


                    <div class="mb-3">
                        <label class="form-label" for="password">Password</label>
                        <input class="form-control" type="password" id="password" name="password" required>
                        <div class="valid-feedback">Looks good!</div>
                    </div>

                    <!-- Agregamos w-100 para estirar el botón a lo ancho de la tarjeta -->
                    <button class="btn btn-success w-100">Register</button>

                </form>
                <!-- Tu formulario original termina aquí -->

            </div>
        </div>
        
    </div>
</div>